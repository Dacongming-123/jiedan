# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zhichuang

# JWT密钥
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Redis配置（可选，用于会话缓存）
REDIS_HOST=localhost
REDIS_PORT=6379

# 短信服务（阿里云SMS）
SMS_ACCESS_KEY_ID=your_key
SMS_ACCESS_KEY_SECRET=your_secret
SMS_SIGN_NAME=智创工坊
SMS_TEMPLATE_CODE=SMS_000000

# 微信OAuth（Mock模式）
WECHAT_APP_ID=mock_wechat_appid
WECHAT_APP_SECRET=mock_wechat_secret

# 支付宝（Mock模式）
ALIPAY_APP_ID=mock_alipay_appid
ALIPAY_PRIVATE_KEY=mock_private_key
ALIPAY_PUBLIC_KEY=mock_public_key

# 微信支付（Mock模式）
WECHAT_PAY_MCH_ID=mock_mch_id
WECHAT_PAY_API_KEY=mock_api_key

# 阿里云OSS文件存储
OSS_ACCESS_KEY_ID=your_key
OSS_ACCESS_KEY_SECRET=your_secret
OSS_BUCKET=zhichuang
OSS_REGION=oss-cn-hangzhou

# Microsoft Clarity
CLARITY_PROJECT_ID=your_clarity_id

# 前端地址（CORS）
FRONTEND_URL=http://localhost:5173

# 数据库备份
BACKUP_DIR=./backups
